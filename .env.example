# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# Never commit .env. It is listed in .gitignore.

# Your own Resend API key (https://resend.com/api-keys).
# Use a key with "Sending access" only.
RESEND_API_KEY=re_replace_with_your_key

# Real Resend API. For the local practice server use http://localhost:4000
RESEND_BASE_URL=https://api.resend.com

# onboarding@resend.dev only delivers to the email on your Resend account.
# To send from your own domain, verify it in Resend and put the address here.
SENDER_EMAIL_ADDRESS=onboarding@resend.dev
